# Gateway 三项均留空：容器仍会下载并启动LiveAgent，但不会连接远程Gateway。
# 若要自动在 Gateway WebUI 显示在线，请填写全部三项。
LIVEAGENT_GATEWAY_URL=https://ai.xxxxx.com

# 使用新生成的唯一 UUID：
# echo "agent-$(cat /proc/sys/kernel/random/uuid)"
# 然后在 Gateway 为该 UUID 签发对应的 agt_ 专属令牌。
LIVEAGENT_AGENT_ID=agent-REPLACE-WITH-YOUR-UUID
LIVEAGENT_AGENT_TOKEN=agt_REPLACE-WITH-TOKEN-BOUND-TO-THE-UUID

# 单 Agent 资源限制
MEMORY_LIMIT=1500m
CPU_LIMIT=1.5
