# Gateway 三项均留空时，容器仍会启动 LiveAgent，但不会连接远程 Gateway。
LIVEAGENT_GATEWAY_URL=https://your-gateway.example.com

# 生成唯一 ID：echo "agent-$(cat /proc/sys/kernel/random/uuid)"
# 然后在 Gateway 为此 ID 签发绑定的 agt_ 专属 Token。
LIVEAGENT_AGENT_ID=agent-REPLACE-WITH-YOUR-UUID
LIVEAGENT_AGENT_TOKEN=agt_REPLACE-WITH-TOKEN-BOUND-TO-THE-UUID

# 单 Agent 资源限制
MEMORY_LIMIT=1024m
MEMORY_RESERVATION=512m
CPU_LIMIT=0.75

# 建议生产环境固定已验证的官方 Release；留空则每次启动查询 latest。
LIVEAGENT_VERSION=

# 虚拟显示参数，一般无需修改。
XVFB_SCREEN=1200x720x16
